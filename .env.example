# Local application configuration
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-south1
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PUBSUB_EMULATOR_HOST=127.0.0.1:8085
RELAY_ENV=local

# Secret names are documented for local setup only. Leave all values empty.
GEMINI_API_KEY=
GOOGLE_OAUTH_CLIENT_SECRET=
MAPS_API_KEY=
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
APP_ENCRYPTION_KEY=

# Google connection and Gmail ingestion configuration (non-secret)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/v1/google/callback
GOOGLE_OAUTH_STATE_SIGNING_KEY=
GOOGLE_GMAIL_LABEL_ID=
GOOGLE_GMAIL_TOPIC=
GOOGLE_PUBSUB_PUSH_AUDIENCE=http://localhost:8080/v1/events/gmail
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=

# Google Cloud deployment configuration (non-secret)
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_LOCATION=asia-south1
GOOGLE_GENAI_USE_VERTEXAI=true
